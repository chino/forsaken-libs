#!/bin/bash -x
cd "$(dirname -- "$0")"
v=2.32.10
f=SDL2-$v
[[ -d $f ]] || git clone --depth 1 --branch release-$v https://github.com/libsdl-org/SDL "$f" || exit 1
mkdir "$f/tmp"
(
	cd "$f/tmp" &&
	../configure --prefix= &&
	make install DESTDIR=$PWD/../../.. \
		LDFLAGS=' -L/usr/lib/i386-linux-gnu/mesa' # this is benign if not on linux
) || exit 1
rm -rf "$f/tmp"
cp pkgconfig/sdl2.pc ../lib/pkgconfig/
echo "Built: sdl"
